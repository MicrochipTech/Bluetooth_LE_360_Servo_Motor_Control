/*
 * PWM LED Configuration for WBZ451 Curiosity
 * 
 * This overlay file configures the RGB LEDs as PWM-controlled LEDs
 * Red LED:   PB0 - TC0 WO1
 * Green LED: PB3 - TC2 WO1
 * Blue LED:  PB5 - TC3 WO1
 */

/ {
	leds {
		compatible = "gpio-leds";
		led3: led_3 {
			gpios = <&portb 7 GPIO_ACTIVE_LOW>;
			label = "User LED 1";
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		status = "okay";
		pwm_led0: pwm_led_0 {
			status = "okay";
			pwms = <&tc0 1 PWM_MSEC(20) 0>;
		};
		red_pwm_led: red_pwm_led {
			status = "okay";
			pwms = <&tc0 1 PWM_USEC(20) 0>;
		};
		green_pwm_led: green_pwm_led {
			status = "okay";
			pwms = <&tc2 1 PWM_USEC(20) 0>;
		};
		blue_pwm_led: blue_pwm_led {
			status = "okay";
			pwms = <&tc3 1 PWM_USEC(20) 0>;
		};
		servo_pwm: servo_pwm {
			status = "okay";
			pwms = <&tc0 1 PWM_MSEC(20) 0>;
		};
	};

	aliases {
		led3 = &led3;
		pwm-led0 = &pwm_led0;
		pwm-servo = &servo_pwm;
		red-pwm-led = &red_pwm_led;
		green-pwm-led = &green_pwm_led;
		blue-pwm-led = &blue_pwm_led;
	};
};

/* Enable timer/counter modules for PWM */
&tc0 {
	status = "okay";
	pinctrl-0 = <&tc0_pwm_default>;
	pinctrl-names = "default";
};

&tc2 {
	status = "okay";
	pinctrl-0 = <&tc2_pwm_default>;
	pinctrl-names = "default";
};

&tc3 {
	status = "okay";
	pinctrl-0 = <&tc3_pwm_default>;
	pinctrl-names = "default";
};
